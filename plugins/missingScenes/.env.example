# Integration test configuration (test_integration.py)
# Copy this file to .env and fill in your values.
# The scripts only run with STASH_PLUGINS_INTEGRATION=1 set in the real environment;
# .env can't enable them. Point STASH_URL at a test instance, never production.

# Local Stash instance
STASH_URL=http://localhost:9999
STASH_API_KEY=your-stash-api-key

# StashDB (for testing endpoint matching)
STASHDB_URL=https://stashdb.org/graphql
STASHDB_API_KEY=your-stashdb-api-key

# Whisparr (test_whisparr_status.py reads these from the real environment, not .env)
# WHISPARR_URL=http://localhost:6969
# WHISPARR_API_KEY=your-whisparr-api-key
